<!-- Admin Modals Partial View -->

<!-- Category Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="modal-title fw-800" id="catModalTitle">Add New <span class="text-info">Category</span></h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="catId">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control rounded-4 border px-4 shadow-none" id="catName" placeholder="Category Name" required>
                    <label for="catName" class="px-4 text-muted">Category Name</label>
                </div>
                <button class="btn btn-info w-100 py-3 rounded-4 fw-bold text-white shadow-lg" id="catSaveBtn" onclick="saveCategory()">
                    Create Category
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Product Modal -->
<div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="modal-title fw-800" id="prodModalTitle">Add New <span class="text-primary">Product</span></h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <input type="hidden" id="prodId">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input type="text" class="form-control rounded-4 border px-4 shadow-none" id="prodName" placeholder="Product Name" required>
                            <label for="prodName" class="px-4 text-muted">Product Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <select class="form-select rounded-4 border px-4 shadow-none" id="prodCategory" required>
                                <option value="">Select Category</option>
                            </select>
                            <label for="prodCategory" class="px-4 text-muted">Category</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating mb-3">
                            <textarea class="form-control rounded-4 border px-4 shadow-none" id="prodDesc" placeholder="Description" style="height: 100px"></textarea>
                            <label for="prodDesc" class="px-4 text-muted">Description</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input type="number" step="0.01" class="form-control rounded-4 border px-4 shadow-none" id="prodPrice" placeholder="Price" required>
                            <label for="prodPrice" class="px-4 text-muted">Price ($)</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating mb-3">
                            <input type="number" class="form-control rounded-4 border px-4 shadow-none" id="prodStock" placeholder="Stock" required>
                            <label for="prodStock" class="px-4 text-muted">Stock Quantity</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="px-2 text-muted mb-2 small fw-bold">Product Image</label>
                        <input type="hidden" id="prodImageUrl">
                        <div class="d-flex gap-3 align-items-start">
                            <div class="border rounded-3 d-flex align-items-center justify-content-center bg-light overflow-hidden" style="width:80px;height:80px;flex-shrink:0;">
                                <i class="fa-solid fa-image text-muted fa-2x" id="imagePreviewIcon"></i>
                                <img id="imagePreviewImg" src="" class="d-none" style="width:80px;height:80px;object-fit:cover;">
                            </div>
                            <div class="flex-grow-1">
                                <button class="btn btn-outline-primary rounded-4 px-4 fw-bold w-100 py-3" type="button" onclick="$('#imageUploadInput').click()">
                                    <i class="fa-solid fa-cloud-arrow-up me-1"></i> Görsel Seç
                                </button>
                                <div id="uploadStatus" class="small mt-2 px-1 d-none"></div>
                            </div>
                        </div>
                        <input type="file" id="imageUploadInput" class="d-none" accept="image/*" onchange="handleProductImageUpload(this)">
                    </div>
                </div>
                <button class="btn btn-primary w-100 py-3 rounded-4 fw-bold shadow-lg mt-3" id="prodSaveBtn" onclick="saveProduct()">
                    Launch Product
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Coupon Modal -->
<div class="modal fade" id="couponModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 rounded-4 shadow-lg">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="modal-title fw-800">Create <span class="text-warning">Coupon</span></h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control rounded-4 border px-4 shadow-none" id="coupCode" placeholder="Coupon Code" required>
                    <label for="coupCode" class="px-4 text-muted">Coupon Code (e.g. SUMMER25)</label>
                </div>
                <div class="form-floating mb-3">
                    <input type="number" step="0.01" class="form-control rounded-4 border px-4 shadow-none" id="coupAmount" placeholder="Discount Amount" required>
                    <label for="coupAmount" class="px-4 text-muted">Discount Amount ($)</label>
                </div>
                <div class="form-floating mb-4">
                    <input type="date" class="form-control rounded-4 border px-4 shadow-none" id="coupExpiry" placeholder="Expiry Date" required>
                    <label for="coupExpiry" class="px-4 text-muted">Expiry Date</label>
                </div>
                <button class="btn btn-warning w-100 py-3 rounded-4 fw-bold text-white shadow-lg" onclick="saveCoupon()">Activate</button>
            </div>
        </div>
    </div>
</div>
