@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Ürünleri Yönet";
}

<div id="adminContainer" style="display:none;">
    <div class="d-flex align-items-center justify-content-between mb-4 fade-in">
        <div>
            <h1 class="display-6 fw-800 mb-0">Ürün <span class="text-primary-gradient">Yönetimi</span></h1>
            <p class="text-muted">Kataloğunuzdan ürün ekleyin, düzenleyin veya kaldırın</p>
        </div>
        <button class="btn btn-primary rounded-pill shadow-lg px-4 py-2" data-bs-toggle="modal" data-bs-target="#productModal">
            <i class="fa-solid fa-plus me-1"></i> Ürün Ekle
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-4 fade-in-up">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 custom-table">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Görsel</th>
                            <th>Ürün Adı</th>
                            <th>Kategori</th>
                            <th>Fiyat</th>
                            <th>Stok</th>
                            <th class="text-center pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="productsTableBody">
                        <!-- Products will be loaded here -->
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="spinner-border text-primary" role="status"></div>
                                <p class="mt-2 text-muted">Ürünler yükleniyor...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Reuse the Product Modal from Admin.cshtml logic or include it here -->
@await Html.PartialAsync("_AdminModals")

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Specialized fetch for this page
            fetchProductsList();
        });

        function fetchProductsList() {
            $.get(`${window.API_BASE_URL}/Products`, function(data) {
                const tbody = $('#productsTableBody');
                tbody.empty();
                data.forEach(p => {
                    tbody.append(`
                        <tr>
                            <td class="ps-4">
                                <img src="${p.imageUrl}" class="rounded-3 shadow-sm" style="width: 48px; height: 48px; object-fit: cover;" onerror="this.src='https://placehold.co/48x48?text=P'">
                            </td>
                            <td><span class="fw-bold text-dark">${p.name}</span></td>
                            <td><span class="badge bg-primary-soft text-primary rounded-pill px-3 py-2">${p.categoryName}</span></td>
                            <td class="fw-bold text-primary">$${p.price.toFixed(2)}</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="me-2">${p.stock}</span>
                                    <div class="progress flex-grow-1" style="height: 6px; width: 60px;">
                                        <div class="progress-bar bg-success" style="width: ${Math.min(p.stock, 100)}%"></div>
                                    </div>
                                </div>
                            </td>
                            <td class="text-center pe-4">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                    <button class="btn btn-white btn-sm px-3" onclick="editProduct(${p.id})"><i class="fa-solid fa-pen-to-square text-info"></i></button>
                                    <button class="btn btn-white btn-sm px-3" onclick="deleteProduct(${p.id})"><i class="fa-solid fa-trash text-danger"></i></button>
                                </div>
                            </td>
                        </tr>
                    `);
                });
            });
        }
    </script>
}
