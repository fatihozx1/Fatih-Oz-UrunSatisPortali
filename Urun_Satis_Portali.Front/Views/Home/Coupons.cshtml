@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Kuponları Yönet";
}

<div id="adminContainer" style="display:none;">
    <div class="d-flex align-items-center justify-content-between mb-4 fade-in">
        <div>
            <h1 class="display-6 fw-800 mb-0">Kupon <span class="text-warning-gradient">Yönetimi</span></h1>
            <p class="text-muted">İndirim kodları oluşturun ve yönetin</p>
        </div>
        <button class="btn btn-warning text-white rounded-pill shadow-lg px-4 py-2" data-bs-toggle="modal" data-bs-target="#couponModal">
            <i class="fa-solid fa-plus me-1"></i> Yeni Kupon
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-4 fade-in-up">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 custom-table text-center">
                    <thead class="bg-light">
                        <tr>
                            <th>Kupon Kodu</th>
                            <th>İndirim Tutarı</th>
                            <th>Son Kullanma Tarihi</th>
                            <th>Durum</th>
                            <th class="pe-4">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="couponsTableBody">
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="spinner-border text-warning" role="status"></div>
                                <p class="mt-2 text-muted">Kuponlar yükleniyor...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_AdminModals")

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            fetchCouponsList();
        });

        function fetchCouponsList() {
            $.get(`${window.API_BASE_URL}/Coupons`, function(data) {
                const tbody = $('#couponsTableBody');
                tbody.empty();
                data.forEach(c => {
                    const expiryDate = new Date(c.expiryDate).toLocaleDateString();
                    const isExpired = new Date(c.expiryDate) < new Date();
                    
                    tbody.append(`
                        <tr>
                            <td><span class="badge bg-light text-dark border px-3 py-2 fw-bold fs-6">${c.code}</span></td>
                            <td class="fw-bold text-success">$${c.discountAmount.toFixed(2)}</td>
                            <td class="text-muted">${expiryDate}</td>
                            <td>
                                <span class="badge ${isExpired ? 'bg-danger-soft text-danger' : 'bg-success-soft text-success'} rounded-pill px-3 py-2">
                                    ${isExpired ? 'Süresi Dolmuş' : 'Aktif'}
                                </span>
                            </td>
                            <td class="pe-4">
                                <div class="btn-group shadow-sm rounded-pill overflow-hidden">
                                    <button class="btn btn-white btn-sm px-3" onclick="deleteCoupon(${c.id})"><i class="fa-solid fa-trash text-danger"></i></button>
                                </div>
                            </td>
                        </tr>
                    `);
                });
            });
        }
    </script>
}

<style>
    .text-warning-gradient {
        background: linear-gradient(135deg, #ffc107 0%, #cc9a06 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
</style>
